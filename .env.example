# Optional. Used only when a picture drifts. Never shown in the app.
# KONTEXT_API_URL=
# KONTEXT_API_TOKEN=

# Houses list. Authorization: Bearer <place session from house redeem>.
# 200 { "properties": [{ id, name, suburb, ownerId, placeId, externalPlaceId, placeName }] }.
# An empty list is 200 with []. 401 is a failed load. The Worker uses this URL when unset.
# PROPERTY_URL=https://property.daup.co.za/api/properties
# HOUSE_SEED_URL=https://mcp.daup.co.za

# Dev only. Serves a stand-in list from the Hub hints. Not sample drawings.
# PROPERTY_MOCK=1
