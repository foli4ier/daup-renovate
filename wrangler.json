{
  "name": "daup-renovate",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "HOUSE_SEED_URL": "https://mcp.daup.co.za"
  }
}
